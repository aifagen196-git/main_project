{
  "name": "collectors",
  "version": "1.0.0",
  "description": "Job collectors — one script per ATS, each reading its slug list from config/.",
  "main": "collectors/greenhouse.js",
  "scripts": {
    "dev": "node collectors/greenhouse.js",
    "start": "node collectors/greenhouse.js",
    "greenhouse": "node collectors/greenhouse.js",
    "ashby": "node collectors/ashby.js",
    "lever": "node collectors/lever.js",
    "workable": "node collectors/workable.js",
    "smartrecruiters": "node collectors/smartrecruiters.js",
    "linkedin": "node collectors/linkedin.js",
    "all": "node collectors/greenhouse.js && node collectors/ashby.js && node collectors/lever.js && node collectors/workable.js && node collectors/smartrecruiters.js && node collectors/linkedin.js",
    "check:collectors": "node tests/importCollectors.js",
    "backfill": "node scripts/processExistingJobs.js",
    "cleanup": "node scripts/cleanupExpiredJobs.js",
