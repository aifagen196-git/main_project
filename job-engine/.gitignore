# Collector runtime state — regenerated on every run, not source.
# Rotation offsets/throttle levels (searchPlanner.js, adaptiveThrottle.js)
# and the company-name resolution cache (companyEnrichment.js).
.*-search-state.json
.company-cache.json
logs/

# Debug/scratch fixtures produced while testing live against a target site —
# not stable, checked-in test fixtures (those live under samples/).
samples/*-fresh-*.html
samples/*-debug.html
samples/*-debug.js
