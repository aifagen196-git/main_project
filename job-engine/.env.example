# job-engine environment. Copy to .env for local runs; set the same keys as
# GitHub Actions secrets for the scheduled workflow
# (.github/workflows/job-engine.yml). Placeholders only — never real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI enrichment (extractJobProfile.js etc.) ---
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=

# --- ZipRecruiter (collectors/ziprecruiter.js) ---
# Requires ZipRecruiter partner approval — email
# atsintegrations@ziprecruiter.com (or their partner sign-up form) and wait
# for manual approval; there is no self-serve signup. Collector skips itself
# with a clear message if this is unset.
ZIPRECRUITER_API_KEY=

# --- Bright Data (collectors/monster.js; Glassdoor NOT implemented — see
# Job_Scraping_Implementation_Guide.pdf's own Terms-of-Service note before
# building it) ---
# https://brightdata.com — the Web Scraper product's dataset_id is shown on
# its own page in your Bright Data dashboard, one per target site.
BRIGHTDATA_API_KEY=
BRIGHTDATA_MONSTER_DATASET_ID=

# --- Apify ---
# NOT needed by collectors/simplyhired.js or collectors/dice.js anymore —
# both were rebuilt to scrape directly (Playwright, free, no per-result
# billing) after finding live that neither site actually required a paid
# scraper. See each collector's own file header for what was tried and
# found. This section only matters if you add a DIFFERENT Apify-based
# source later (processors/apifyClient.js is still here for that).
# https://apify.com — get APIFY_TOKEN from Console → Settings → Integrations.
APIFY_TOKEN=

# --- Tuning (all optional, sane defaults in code) ---
SCRAPE_LAST_HOURS=24
UPSERT_CHUNK=100
ZIPRECRUITER_MAX_PAGES=5
BRIGHTDATA_BATCH_SIZE=15
SIMPLYHIRED_SEARCH_DELAY_MS=2000
DICE_SEARCH_DELAY_MS=2000
