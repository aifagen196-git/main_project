# job-engine environment. Copy to .env for local runs; set the same keys as
# GitHub Actions secrets for the scheduled workflow
# (.github/workflows/job-engine.yml). Placeholders only — never real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI enrichment (extractJobProfile.js etc.) ---
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=

# --- ZipRecruiter (collectors/ziprecruiter.js) ---
# Requires ZipRecruiter partner approval — email
# atsintegrations@ziprecruiter.com (or their partner sign-up form) and wait
# for manual approval; there is no self-serve signup. Collector skips itself
# with a clear message if this is unset.
ZIPRECRUITER_API_KEY=

# --- Bright Data (collectors/monster.js; Glassdoor NOT implemented — see
# Job_Scraping_Implementation_Guide.pdf's own Terms-of-Service note before
# building it) ---
# https://brightdata.com — the Web Scraper product's dataset_id is shown on
# its own page in your Bright Data dashboard, one per target site.
BRIGHTDATA_API_KEY=
BRIGHTDATA_MONSTER_DATASET_ID=

# --- Apify ---
# NOT needed by collectors/simplyhired.js or collectors/dice.js anymore —
# both were rebuilt to scrape directly (Playwright, free, no per-result
# billing) after finding live that neither site actually required a paid
# scraper. See each collector's own file header for what was tried and
# found. This section only matters if you add a DIFFERENT Apify-based
# source later (processors/apifyClient.js is still here for that).
# https://apify.com — get APIFY_TOKEN from Console → Settings → Integrations.
APIFY_TOKEN=

# --- Free-tier job-board APIs (each collector aborts cleanly with a clear
# message if its own key is unset — safe to leave any of these blank).
# Register at each provider for a free key: instant for Adzuna/Jooble/
# JSearch/USAJobs, manual approval for Careerjet/Findwork.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CAREERJET_API_KEY=
FINDWORK_API_KEY=
JOOBLE_API_KEY=
JSEARCH_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# --- Tuning (all optional, sane defaults in code) ---
SCRAPE_LAST_HOURS=24
UPSERT_CHUNK=100
ZIPRECRUITER_MAX_PAGES=5
BRIGHTDATA_BATCH_SIZE=15
SIMPLYHIRED_SEARCH_DELAY_MS=2000
DICE_SEARCH_DELAY_MS=2000

# --- Further per-collector tuning (all optional, sane defaults in code) ---
# Every *_MAX_PAGES / *_MAX_RESULTS / *_REQUEST_DELAY_MS / *_MAX_REQUESTS_PER_RUN
# below controls how much a given collector fetches per run and how long it
# waits between requests — tune only if a source is rate-limiting you or you
# want deeper/shallower coverage. None of these need to be set for a working
# deploy. MUSE_API_KEY and KFORCE_SEARCH_API_KEY are optional too (each
# collector has a working public fallback).
ADZUNA_MAX_PAGES=
ADZUNA_MAX_RESULTS=
ADZUNA_MAX_REQUESTS_PER_RUN=
ADZUNA_REQUEST_DELAY_MS=
ARBEITNOW_MAX_PAGES=
ARBEITNOW_MAX_RESULTS=
ARBEITNOW_REQUEST_DELAY_MS=
AVATURE_MAX_PAGES=
BUILTIN_MAX_PAGES=
BUILTIN_MAX_RESULTS=
BUILTIN_REQUEST_DELAY_MS=
CAREERJET_LOCALE=
CAREERJET_LOCATION=
CAREERJET_MAX_PAGES=
CAREERJET_MAX_RESULTS=
CAREERJET_MAX_REQUESTS_PER_RUN=
CAREERJET_PAGE_SIZE=
CAREERJET_REQUEST_DELAY_MS=
CAREERJET_USER_AGENT=
CAREERJET_USER_IP=
DAILYREMOTE_MAX_PAGES=
DAILYREMOTE_MAX_RESULTS=
DAILYREMOTE_REQUEST_DELAY_MS=
FINDWORK_MAX_RESULTS=
FINDWORK_MAX_REQUESTS_PER_RUN=
FINDWORK_REQUEST_DELAY_MS=
HACKERNEWS_MAX_RESULTS=
HACKERNEWS_REQUEST_DELAY_MS=
HACKERNEWS_SCRAPE_LAST_HOURS=
HIMALAYAS_MAX_PAGES=
HIMALAYAS_REQUEST_DELAY_MS=
HIRINGCAFE_MAX_PAGES=
HIRINGCAFE_MAX_RESULTS=
HIRINGCAFE_REQUEST_DELAY_MS=
ICIMS_MAX_PAGES=
INDEED_MAX_PAGES=
INDEED_SEARCH_DELAY_MS=
INDEED_SEARCH_PAIRS=
INDEED_DETAIL_CLICK_DELAY_MS=
INDEED_DETAIL_FETCHES_PER_SEARCH=
JAZZHR_REQUEST_DELAY_MS=
JOBICY_MAX_RESULTS=
JOBICY_REQUEST_DELAY_MS=
JOBICY_RESULTS_PER_SEARCH=
JOBRIGHT_SEARCH_DELAY_MS=
JOBVERTISE_BY_STATE=
JOBVERTISE_MAX_RESULTS=
JOBVERTISE_REQUEST_DELAY_MS=
JOOBLE_LOCATION=
JOOBLE_MAX_PAGES=
JOOBLE_MAX_RESULTS=
JOOBLE_MAX_REQUESTS_PER_RUN=
JOOBLE_REQUEST_DELAY_MS=
JSEARCH_HOST=
JSEARCH_VIA_RAPIDAPI=
JSEARCH_PUBLISHER_FILTER=
JSEARCH_MAX_PAGES=
JSEARCH_MAX_REQUESTS_PER_RUN=
JSEARCH_REQUEST_DELAY_MS=
JSEARCH_DEBUG=
KFORCE_SEARCH_API_KEY=
KFORCE_SEARCH_ENDPOINT=
LINKEDIN_MAX_PAGES=
LINKEDIN_SEARCH_PAIRS=
LINKEDIN_MAX_SEARCH_REQUESTS=
LINKEDIN_SEARCH_DELAY_MS=
LINKEDIN_DETAIL_DELAY_MS=
MUSE_API_KEY=
MUSE_MAX_PAGES=
MUSE_MAX_RESULTS=
MUSE_REQUEST_DELAY_MS=
POSTJOBFREE_LOCATION=
POSTJOBFREE_MAX_PAGES=
POSTJOBFREE_MAX_RESULTS=
POSTJOBFREE_REQUEST_DELAY_MS=
REMOTIVE_MAX_RESULTS=
REMOTIVE_REQUEST_DELAY_MS=
SUCCESSFACTORS_MAX_PAGES=
USAJOBS_MAX_PAGES=
USAJOBS_MAX_RESULTS=
USAJOBS_REQUEST_DELAY_MS=
WORKABLE_DETAIL_CONCURRENCY=

# --- Misc tuning / dev-only filters (all optional) ---
ARCHIVE_AFTER_DAYS=
BACKFILL_ALL=
BACKFILL_CONCURRENCY=
BACKFILL_LIMIT=
COLLECTOR_BLOCK_COOLDOWN_MS=
COLLECTOR_LLM=
DEDUPE_CHUNK=
DETAIL_CONCURRENCY=
MAX_LISTINGS_PER_COMPANY=
MAX_PARTITION_DEPTH=
# Restrict a run to specific companies/keywords/queries during local
# debugging — comma-separated, matched against each collector's own config.
ONLY_COMPANIES=
ONLY_KEYWORDS=
ONLY_QUERIES=
SAVE_CHUNK=
SAVE_MIN_SPLIT=
UPSERT_MIN_SPLIT=
VERIFY_CONCURRENCY=
