# Backend environment. Copy to .env for local dev; set these in your host's
# environment/secrets settings for production. Everything here can be a
# secret — this file never has real values, only placeholders.

NODE_ENV=production
PORT=5000

# --- Supabase ---
# Service-role key: full DB access, bypasses RLS. Server-side only — never
# send it to the frontend or a browser-reachable endpoint.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Model providers used by backend/src/services/ai/* ---
# The backend tries providers in order: Claude -> Groq -> Gemini (see
# services/ai/*). Only Groq + Gemini are required for a working deploy;
# Anthropic/OpenAI are optional extras, commented out below the same way
# they are in local dev when unset — leaving them blank just means that
# provider is skipped, not a broken deploy.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=
GROQ_API_KEY=your-groq-key
GROQ_MODEL=
GROQ_TIMEOUT_MS=
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=
# ANTHROPIC_JUDGE_MODEL=
# ANTHROPIC_MAX_RETRIES=

# --- Embeddings (semantic match scoring — optional, see
# services/matching/*) ---
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_PROVIDER=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DIMS=
# OPENAI_API_KEY=

# --- Matching tuning (all optional, sane defaults in code) ---
MATCH_CACHE_MINUTES=
MATCH_EMBED_BACKFILL=
MATCH_FRESH_DAYS=
MATCH_JUDGE_CONCURRENCY=
MATCH_JUDGE_TOP_N=
MATCH_POOL_TTL_MINUTES=

# --- Razorpay (see services/payments/razorpay.service.js) ---
# Key ID is also sent to the browser (services/subscription.js opens the
# Razorpay checkout modal client-side) — that's expected, it's not a secret.
# Key secret and webhook secret are server-only; never expose them.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# From the webhook's settings page in the Razorpay dashboard, not the same
# value as the key secret above.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Optional — defaults to USD if unset.
RAZORPAY_CURRENCY=USD

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API, e.g.:
#   CORS_ORIGIN=https://aifagenlabs.com,https://www.aifagenlabs.com
# Required in production — the code falls back to http://localhost:5173 when
# unset, which would reject every request from the deployed frontend (looks
# identical to "the backend is down" from the browser). See app.js.
CORS_ORIGIN=https://your-frontend-domain.com
