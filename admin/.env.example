# Admin app environment. Copy to .env for local dev; set these in your
# host's build settings for production. Vite only exposes VITE_-prefixed
# vars, inlined AT BUILD TIME.
#
# Same Supabase project as frontend/ — this app authenticates as a real
# Supabase user (via Auth) and relies entirely on the internal_jobs RLS
# policies (see supabase/migrations/0012_internal_jobs.sql) to allow writes
# only for rows present in the admins table. The anon key is safe to expose;
# it grants nothing on its own without a matching admins row.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
