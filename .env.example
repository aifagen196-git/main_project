# ====================================
# FRONTEND  (frontend/.env — Vite exposes only VITE_* to the browser)
# ====================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the Express backend (all data/AI/payments go through it).
VITE_API_URL=http://localhost:5000

# ====================================
# BACKEND  (backend/.env — the API layer; talks to Supabase + Claude + Razorpay)
# ====================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=5000
# Comma-separated allowed browser origins (the frontend URL).
CORS_ORIGIN=http://localhost:5173

# Anthropic Claude (LLM) — server-held key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Razorpay (payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD

# ====================================
# COLLECTORS  (collectors/.env)
# ====================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# LLM job enrichment via Claude (shares prompts with the backend). Leave blank
# to use the regex/dictionary fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# How many hours back to scrape / the staleness cutoff for deactivation.
SCRAPE_LAST_HOURS=24
