# Frontend environment. Copy to .env for local dev; set these in your host's
# build settings for production. Vite only exposes VITE_-prefixed vars, and it
# inlines them AT BUILD TIME — changing them means rebuilding, not restarting.
#
# Never put a secret here. Everything in this file ends up readable in the
# public JS bundle. Service-role keys and model API keys belong on the backend.

# --- Supabase (public, safe to expose) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Backend API base URL ---
# Leave UNSET when the frontend and backend are served from the same origin
# (a reverse proxy or platform rewrite forwarding /api/* to the backend) —
# requests then go to a relative /api/... path, which is the usual production
# setup.
#
# Set it only when the backend lives on a different host, with NO trailing
# slash and NO /api suffix:
#   VITE_API_URL=https://api.aifagenlabs.com
#
# In dev, leaving this unset targets <current-host>:5000, so localhost and
# phone-over-LAN both work without pinning an IP.
# VITE_API_URL=
